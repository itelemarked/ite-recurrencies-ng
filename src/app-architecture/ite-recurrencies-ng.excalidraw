      "seed": 1878642249,
      "version": 1600,
      "versionNonce": 840684793,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768910518775,
      "link": null,
      "locked": false,
      "text": "i: The end of the period unit effects the expiry date\nMake sure to choose the right period!\n\nExamples:\nGiven an event on 03.06.25 and a period of 2 \"years\"\ndefines a expiry on 31.12.27 (end of \"year\"), and a\nperiod of 24 \"months\" defines an expiry on 30.6.27\n(end of \"month\")",
      "fontSize": 15.992026840843028,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "i: The end of the period unit effects the expiry date Make sure to choose the right period!\n\nExamples:\nGiven an event on 03.06.25 and a period of 2 \"years\" defines a expiry on 31.12.27 (end of \"year\"), and a period of 24 \"months\" defines an expiry on 30.6.27 (end of \"month\")",
      "autoResize": false,
      "lineHeight": 1.25
    },
