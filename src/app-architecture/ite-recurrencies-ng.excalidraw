    {
      "id": "io6RXMA-YyLGMCJYagXQi",
      "type": "text",
      "x": 4077.3519627559963,
      "y": 5231.188330745267,
      "width": 363.4877608266885,
      "height": 162.1026812213475,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 60,
      "groupIds": [],
      "frameId": null,
      "index": "b5L",
      "roundness": null,
      "seed": 1878642249,
      "version": 2043,
      "versionNonce": 1536252184,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781813625384,
      "link": null,
      "locked": false,
      "text": "i: The end of the period unit affects the\nexpiry date. Make sure to choose the right\nperiod!\nExamples:\nGiven an event on 03.06.25 and a period of\n2 \"years\" defines a expiry on 31.12.27 (end\nof \"year\"), and a period of 24 \"months\"\ndefines an expiry on 30.6.27 (end of \"month\")",
      "fontSize": 16.21026812213475,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "i: The end of the period unit affects the expiry date. Make sure to choose the right period!\nExamples:\nGiven an event on 03.06.25 and a period of 2 \"years\" defines a expiry on 31.12.27 (end of \"year\"), and a period of 24 \"months\" defines an expiry on 30.6.27 (end of \"month\")",
      "autoResize": false,
      "lineHeight": 1.25
    },
