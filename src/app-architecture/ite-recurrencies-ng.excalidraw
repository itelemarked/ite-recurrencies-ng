    {
      "id": "oKS_Gh1_asj1FECSY5K2A",
      "type": "text",
      "x": -2001.7143434074615,
      "y": -314.59443135756146,
      "width": 667.9596557617188,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5I",
      "roundness": null,
      "seed": 1589901897,
      "version": 838,
      "versionNonce": 881114035,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768071042028,
      "link": null,
      "locked": false,
      "text": "When changing timezone, an error must be taken into account...\nerror = timezoneOffset(when saved) - timezoneOffset(when read)\n\nE.g: from timezone +6 to timezone -2: error = +6 - (-2) = +8 hours\nE.g: from timezone +6 to timezone +10: error = +6 - (+10) = -4 hours",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When changing timezone, an error must be taken into account...\nerror = timezoneOffset(when saved) - timezoneOffset(when read)\n\nE.g: from timezone +6 to timezone -2: error = +6 - (-2) = +8 hours\nE.g: from timezone +6 to timezone +10: error = +6 - (+10) = -4 hours",
      "autoResize": true,
      "lineHeight": 1.25
    },
