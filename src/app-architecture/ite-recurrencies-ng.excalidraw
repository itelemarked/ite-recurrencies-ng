    {
      "id": "ckOoB5MS0onjh3P2UlxUJ",
      "type": "text",
      "x": 1672.0203384314002,
      "y": 3442.8617273163663,
      "width": 566.1396484375,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1n",
      "roundness": null,
      "seed": 521753073,
      "version": 475,
      "versionNonce": 1514607069,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768071064050,
      "link": null,
      "locked": false,
      "text": "ITEM ACTIONS:\n\n- Long press = update last event to today (confirm alert)\n- Short press = navigate to recurrency-edit.page\n- Swipe left = delete item\n\nMENU BTN:\nShows a ion-select action sheet",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ITEM ACTIONS:\n\n- Long press = update last event to today (confirm alert)\n- Short press = navigate to recurrency-edit.page\n- Swipe left = delete item\n\nMENU BTN:\nShows a ion-select action sheet",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RepD2wgVrUyzLRyULnIjd",
      "type": "text",
      "x": 2879.6470461974354,
      "y": 3429.83773106014,
      "width": 699.4594116210938,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1o",
      "roundness": null,
      "seed": 1016991921,
      "version": 1322,
      "versionNonce": 1721945661,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768071064050,
      "link": null,
      "locked": false,
      "text": "ACTIONS:\n\n- Title is a text input. Page title must be changed as well.\n- Last event is a date input. It changes expiry date as well.\n- recurrency period is a ion-picker input\n  When changed, it changes also last-event \n  or expiry (master of last change must be \n  tracked! Default master: last-event)\n- Expires is a date input. It changes last-event as well\n- Info button: active (color red) when there are unsaved changes.\n  shows an alert for unsaved changes if active. \n  Unsaved changes are marked by a red bullet.\n- Back button: saves changes and navigate back to recurrency-list.page",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ACTIONS:\n\n- Title is a text input. Page title must be changed as well.\n- Last event is a date input. It changes expiry date as well.\n- recurrency period is a ion-picker input\n  When changed, it changes also last-event \n  or expiry (master of last change must be \n  tracked! Default master: last-event)\n- Expires is a date input. It changes last-event as well\n- Info button: active (color red) when there are unsaved changes.\n  shows an alert for unsaved changes if active. \n  Unsaved changes are marked by a red bullet.\n- Back button: saves changes and navigate back to recurrency-list.page",
      "autoResize": true,
      "lineHeight": 1.25
    },
